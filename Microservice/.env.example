# ML microservice — copy to .env and fill in one enhancement provider

# Workshop description enhancer: auto tries Ollama → Groq → OpenAI → Hugging Face
ENHANCEMENT_PROVIDER=auto

# Option A — Ollama (free, local): https://ollama.com
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option B — Groq (free tier, cloud): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option C — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option D — Hugging Face (Llama may require model access approval)
HF_API_TOKEN=
HF_ENHANCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
